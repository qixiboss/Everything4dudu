{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "train-site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),fs=require('fs'),p=require('path');h.createServer((q,r)=>{let f=p.join(process.cwd(),q.url==='/'?'index.html':q.url);if(!fs.existsSync(f)){r.writeHead(404);r.end();return}let t={'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml'}[p.extname(f)]||'application/octet-stream';r.writeHead(200,{'Content-Type':t});fs.createReadStream(f).pipe(r)}).listen(process.env.PORT||8000)"],
      "port": 8000,
      "autoPort": true
    }
  ]
}
